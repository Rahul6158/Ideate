# ==============================================================================
# Ideate — Environment Variables Example
# Duplicate this file as .env and fill in your project credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Required for cloud sync & authentication)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable / Anon API Key (sb_publishable_... or legacy anon key)
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional Supabase server-side URL and keys (for SSR or Edge Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 (Optional — for Google Sign-In)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID from Google Cloud Console credentials
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Web Push Notifications (Frontend)
# ------------------------------------------------------------------------------
# Public VAPID Key used by the browser to subscribe to Web Push messages
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ------------------------------------------------------------------------------
# 4. Supabase Edge Functions & Webhook Secrets (Server-side ONLY)
# Set these in your Supabase Dashboard or via CLI: `supabase secrets set KEY=VALUE`
# NEVER expose the private key or webhook secret in client-side VITE_ variables!
# ------------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@ideate.app
# PUSH_WEBHOOK_SECRET=your-secure-random-webhook-secret
